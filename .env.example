# Locations to monitor (according to Cloudflare Status names)
# TARGET_LOCATIONS=jakarta,singapore,manila,bangkok,dhaka,hyderabad,tokyo,astana,izmir,kyiv,dar es salaam,gaborone,luanda,mombasa,port louis,ouagadougou,tunis,kinshasa,phnom penh
TARGET_LOCATIONS=jakarta,singapore

# Slack Bot Token (bot will send to all channels where bot is invited)
# Setup: 1) Create Slack App, 2) Add scopes: channels:read, groups:read, chat:write
#        3) Install to workspace, 4) Invite bot to channels with /invite @BotName
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# Check interval (seconds)
SLEEP_INTERVAL=30

# Log level: INFO, DEBUG, WARNING
LOG_LEVEL=INFO

# Persistent status file (don't change unless you know what you're doing)
STATUS_FILE=/data/last_statuses.json
