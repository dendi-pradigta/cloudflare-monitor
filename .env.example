# ========================
# Location Monitor Settings
# ========================
# Lokasi yang ingin dipantau (sesuai nama di Cloudflare Status)
# TARGET_LOCATIONS=jakarta,singapore,manila,bangkok,dhaka,hyderabad,tokyo,astana,izmir,kyiv,dar es salaam,gaborone,luanda,mombasa,port louis,ouagadougou,tunis,kinshasa,phnom penh
TARGET_LOCATIONS=jakarta,singapore

# ========================
# Slack Notification Settings
# ========================
# Slack Bot Token (starts with xoxb-)
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# Slack Channel ID or name (e.g., #cloudflare-alerts or C01234567)
SLACK_CHANNEL=#cloudflare-alerts

# ========================
# Opsgenie Settings (Optional)
# ========================
# Enable Opsgenie integration (true/false)
OPSGENIE_ENABLED=false

# Opsgenie API Key
OPSGENIE_API_KEY=your-opsgenie-api-key-here

# Opsgenie API URL (default: https://api.opsgenie.com)
OPSGENIE_API_URL=https://api.opsgenie.com

# ========================
# Monitor Settings
# ========================
# Interval pengecekan (detik)
SLEEP_INTERVAL=60

# Level log: INFO, DEBUG, WARNING
LOG_LEVEL=INFO

# ========================
# API Endpoints (Optional - use defaults if not specified)
# ========================
# COMPONENTS_URL=https://www.cloudflarestatus.com/api/v2/components.json
# INCIDENTS_URL=https://www.cloudflarestatus.com/api/v2/incidents.json

# ========================
# Data Files (Optional - use defaults if not specified)
# ========================
# STATUS_FILE=data/last_statuses.json
# INCIDENT_STATUS_FILE=data/last_incidents.json